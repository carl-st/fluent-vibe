# Learning progress IS committed on purpose — every session ends with a
# commit (see .claude/skills/fluent-db-updater/SKILL.md) so progress can be
# continued from another device. Only transient artifacts stay out of git:
/data/*.json.backup-*
/results/*.tmp*

# Personal writing/practice files
myfile.txt

# Backup files created by hooks
.backups/

# Keep directory structure but ignore contents
!/data/.gitkeep
!/results/.gitkeep

# System files
.DS_Store
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Python bytecode
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# Temp files
.tmp/
temp/
*.json.tmp

